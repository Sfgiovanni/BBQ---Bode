# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# ── Ferramentas / sessão ──────────────────────────────────
.claude/
.DS_Store
*.log
.bilingual_bode.pid
.launcher_*.log

# ── Resultados ────────────────────────────────────────────
# Política: versionamos apenas a rodada "full" final (métricas +
# relatório + figuras). Predições brutas e rodadas de teste ficam
# de fora para manter o repositório leve.
results/*
!results/README.md
!results/legacy_portuguese/
!results/runs/
results/runs/*

# Registro cientifico leve da rodada bilingue revisada (sem dados linha a linha,
# logs ou checkpoints). Novas rodadas continuam ignoradas por padrao.
!results/runs/20260710_000126_bilingual_bode_bode-7b-alpaca-pt-br-no-peft/
results/runs/20260710_000126_bilingual_bode_bode-7b-alpaca-pt-br-no-peft/*
